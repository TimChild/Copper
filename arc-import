#!/usr/bin/env python3
"""Bring Arc's sidebar into Copper: every space, its colour, its pinned tabs
and folders' tabs (as tab groups, nested names joined with " › "), and whatever
was left open.

    ./arc-import              write ~/Library/Application Support/Copper/session.json
    ./arc-import --world W    write into the test world "Copper (W)" instead
    ./arc-import --dry        print what would be written

Arc's favourites become the pin grid. Arc folders become Copper's tab
groups (groups.json + a group id on each entry); groups are flat, so a nested
folder's name carries its parents. Arc's per-space pinned tabs are Copper's
Saved section; whatever was left open is Today, newest first, each row
carrying when Arc last had it in front so the archive sweep knows its age.
Folders keep Arc's order (a folder's tabs either side of the folders inside
it), come in open or shut as Arc's window has them, and empty ones come too.
A split view's first two panes come back as a kept split. Arc documents and
easels are skipped. Quit Copper first: it writes the
session on quit and would overwrite this.
"""

import colorsys
import json
import os
import sys
import uuid

ARC = os.path.expanduser("~/Library/Application Support/Arc/StorableSidebar.json")
WINDOWS = os.path.expanduser("~/Library/Application Support/Arc/StorableWindows.json")


def expanded():
    """The folders Arc has open, in any window. Arc keeps this per window,
    not on the folder, so a folder open anywhere comes in open."""
    try:
        return {i for w in json.load(open(WINDOWS)).get("windows", []) for i in w.get("expandedItems", []) if isinstance(i, str)}
    except (OSError, ValueError):
        return set()


def hue(theme):
    """The first saturated colour in Arc's theme blob, as a hue 0…1."""
    found = []

    def walk(node):
        if isinstance(node, dict):
            if {"red", "green", "blue"} <= node.keys() and node.get("alpha", 1) > 0:
                r, g, b = (min(1, max(0, node[k])) for k in ("red", "green", "blue"))
                h, s, v = colorsys.rgb_to_hsv(r, g, b)
                if s > 0.25 and v > 0.2:
                    found.append(h)
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)

    walk(theme.get("primaryColorPalette") or theme)
    return round(found[0], 3) if found else None


def main(argv):
    dry = "--dry" in argv
    world = argv[argv.index("--world") + 1] if "--world" in argv else None
    name = f"Copper ({world})" if world else "Copper"
    out = os.path.expanduser(f"~/Library/Application Support/{name}/session.json")

    sidebar = json.load(open(ARC))["sidebar"]["containers"]
    container = next(c for c in sidebar if isinstance(c, dict) and "spaces" in c)
    items = {i["id"]: i for i in container["items"] if isinstance(i, dict)}
    arc_spaces = [s for s in container["spaces"] if isinstance(s, dict)]

    groups = []
    opened = expanded()
    space_id = None  # the Copper space the walk is in, for empty folders
    pinned_walk = False

    def tabs(parent_id, folder=None, split=None):
        """Every tab under a container: (title, url, group id, last active,
        split token). Folders become groups, nested names joined, in Arc's
        order — Copper draws a folder's tabs either side of the ones inside
        it under one header. A split view's first two panes share a token."""
        children = [items[c] for c in items.get(parent_id, {}).get("childrenIds", []) if c in items]
        panes = 0
        down = 0  # tabs yielded so far under this container: an empty folder's slot
        for node in children:
            cid = node["id"]
            data = node.get("data", {})
            if "tab" in data:
                url = data["tab"].get("savedURL", "")
                if url.startswith("http"):
                    # Arc counts from 2001; everyone else counts from 1970.
                    when = data["tab"].get("timeLastActiveAt")
                    when = when + 978307200 if when else None
                    token = split if split and panes < 2 else None
                    panes += 1
                    down += 1
                    yield node.get("title") or data["tab"].get("savedTitle") or "", url, folder, when, token
            elif "list" in data:
                name = node.get("title") or "Folder"
                if folder:
                    name = next(g["name"] for g in groups if g["id"] == folder) + " › " + name
                gid = str(uuid.uuid4()).upper()
                group = {"id": gid, "name": name, "collapsed": cid not in opened}
                groups.append(group)
                slot, held = down, 0
                for row in tabs(cid, gid):
                    down += 1
                    held += 1
                    yield row
                # Only a folder empty in Arc's Saved list needs telling where
                # it stands; one with tabs is wherever they are, and would
                # otherwise come back as a ghost once emptied.
                if not held and pinned_walk and space_id:
                    group["space"], group["slot"] = space_id, slot
            elif "splitView" in data:
                for row in tabs(cid, folder, str(uuid.uuid4()).upper()):
                    down += 1
                    yield row

    # Favourites — the grid at the top of every space of the default profile.
    tops = container["topAppsContainerIDs"]
    favourites = []
    for profile, tid in zip(tops[::2], tops[1::2]):
        if profile == {"default": True}:
            favourites = list(tabs(tid))
    groups.clear()  # favourites have no folders in Copper's grid

    spaces, entries = [], []
    for s in arc_spaces:
        sid = str(uuid.uuid4()).upper()
        space_id = sid
        space = {"id": sid, "name": s["title"]}
        h = hue(s.get("customInfo", {}).get("windowTheme", {}))
        if h is not None:
            space["hue"] = h
        spaces.append(space)

        ids = s["containerIDs"]
        pinned = ids[ids.index("pinned") + 1]
        unpinned = ids[ids.index("unpinned") + 1]
        # Arc's favourites grid is Copper's pin grid; Arc's per-space pinned
        # tabs have titles, so they are loose tabs here, followed by what was
        # left open.
        for title, url, *_ in favourites:
            host = url.split("/")[2].replace("www.", "")
            entries.append({"url": url, "title": title, "pin": host[:1].upper() or "•", "space": sid})
        # Saved first, then Today newest-first — except that a folder is one
        # run in Copper, so grouped rows keep their own order after the rest.
        # Arc's own order, as its Today list shows it.
        today = list(tabs(unpinned))
        pinned_walk = True
        saved = list(tabs(pinned))
        pinned_walk = False
        row = [(t, True) for t in saved] + [(t, False) for t in today]
        for i, ((title, url, gid, when, split), kept) in enumerate(row):
            entries.append({"url": url, "title": title, "space": sid, "saved": kept,
                            **({"seen": when} if when else {}),
                            **({"active": True} if i == 0 else {}),
                            **({"group": gid} if gid else {}),
                            **({"split": split} if split else {})})

    current = next((sp["id"] for sp in spaces if sp["name"] == "Exowatt"), spaces[0]["id"])
    shape = {"tabs": entries, "active": 0, "spaces": spaces, "space": current}

    for sp in spaces:
        n = sum(1 for e in entries if e["space"] == sp["id"])
        p = sum(1 for e in entries if e["space"] == sp["id"] and "pin" in e)
        s = sum(1 for e in entries if e["space"] == sp["id"] and e.get("saved"))
        t = sum(1 for e in entries if e["space"] == sp["id"] and e.get("saved") is False)
        g = {e["group"] for e in entries if e["space"] == sp["id"] and "group" in e}
        e = sum(1 for gr in groups if gr.get("space") == sp["id"] and gr["id"] not in g)
        k = len({e["split"] for e in entries if e["space"] == sp["id"] and "split" in e})
        print(f"{sp['name']:22} {n:4} tabs ({p} favourites, {s} saved, {t} today, {len(g)} folders + {e} empty, {k} splits)  hue={sp.get('hue')}")
    if dry:
        return
    os.makedirs(os.path.dirname(out), exist_ok=True)
    json.dump(shape, open(out, "w"))
    groups_out = os.path.join(os.path.dirname(out), "groups.json")
    json.dump({"groups": groups, "rules": []}, open(groups_out, "w"))
    print(f"wrote {out} and groups.json ({len(groups)} folders)")


if __name__ == "__main__":
    main(sys.argv[1:])
