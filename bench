#!/usr/bin/env python3
"""Drive the Copper you already have open, from the shell.

    ./bench tabs                       every tab, yours and the bench's
    ./bench open URL                   a bench tab at the end of the row → its id
    ./bench go ID URL                  send a bench tab somewhere else
    ./bench wait ID [SECONDS]          until the page has loaded
    ./bench sleep ID                   put a tab to sleep now, or say what keeps it awake
    ./bench select ID                  bring a tab to the front — --test runs only
    ./bench resize W H [STEPS]         take the window to W×H in steps, like a drag — --test runs only
    ./bench key ID TEXT [--app] [--hold] press keys on a tab as real key events — --test runs only;
                                       ⌘ ⇧ ⌥ ⌃ hold for the next key, ⇥ is Tab, ← → ↑ ↓ ⎋ ↩ are
                                       arrows/Escape/Return; --app sends through the app's own key monitor;
                                       --hold leaves ⌃ down for the next key, and ⌃release lets go
    ./bench text ID                    the page's text
    ./bench eval ID JS                 run JavaScript, print what it returns
    ./bench click ID SELECTOR
    ./bench type ID SELECTOR TEXT
    ./bench submit ID SELECTOR         the form around SELECTOR
    ./bench shot ID [PATH] [WIDTH]     a PNG of the page → its path
    ./bench close ID | all             only tabs the bench opened
    ./bench probe                      the window's own state: panels, modal, windows
    ./bench extensions                 installed extensions, loaded or not, with their warnings
    ./bench ext-add ID|LINK [--yes]    install from the Chrome Web Store (--yes only in a --test run)
    ./bench ext-folder PATH [--yes]    install an unpacked extension
    ./bench ext-press ID               press its button
    ./bench ext-page ID [PATH]         one of its pages in a bench tab → tab id, for eval
    ./bench ext-popup ID JS            run JavaScript in its popup while it is open
    ./bench ext-reload ID              take it up again (a folder one is copied in afresh)
    ./bench ext-pin ID [on|off]        keep its button in the row beside the puzzle
    ./bench ext-menu PATH              the puzzle button's list, drawn to a PNG
    ./bench ext-shot ID PATH           a picture of its popup while it is open
    ./bench ext-answer yes|no|ask      test run: answer extensions' questions without asking; lists what was asked
    ./bench ext-enable ID on|off       switch an extension on or off
    ./bench ext-remove ID
    ./bench ext-manager [open [ID]|close|toggle|manage|expand ID|none|search TEXT]
                                       the Extensions page over the window (the foot's puzzle door,
                                       the pill's puzzle piece, every Manage Extensions…); ID opens
                                       that one's details; manage goes the way the puzzle piece does;
                                       `window PATH` takes it as it is on screen
    ./bench ext-manager picture PATH [light|dark]
                                       the page drawn off screen, every row laid out whole
    ./bench ext-manager site ID PATTERN on|off
                                       allow or take back one site it asked for (kept across launches)
    ./bench ext-manager remove ID | answer remove|cancel
                                       the Remove sheet, and its buttons
    ./bench updates status|check|stub URL|stage|dry-run on|off|upgrade
    ./bench downloads [open|close|cancel ID|retry ID|clear|start URL]
    ./bench render bitwarden|drive|hands|hands-dark PATH  one card drawn to a PNG on its own, no window brought forward
    ./bench drive [status|stop|resume|clear|pane on|off]
    ./bench drive fake NAME THREAD… [tab N|ID] [--for S] [--doing WORDS…]   a stand-in agent's hand on a tab; drive card N|off; drive unfake
                                       who is driving the page (Jev, an agent, a bot) and every row of the timeline
    ./bench bw status|server URL|login EMAIL PW [OTP] [--method N]|code OTP|cancel|unlock PW|lock|sync|candidates HOST|choose ID
              |identities|cards|fields HOST|usernames|counts|autofill card|identity ID
              |share all|ID on|off|backend keychain|bitwarden|settings passwords|offer keep
                                       Bitwarden probe controls and Copper feed status
    ./bench spaces [new NAME|select N|next|prev|move N|remove N [--keep]|profile NAME]
    ./bench spaces [icon N EMOJI|sf:symbol|none|colour N NAME|reorder N M]
    ./bench spaces [page [N]|page close|tap N|tap header]
                                       the Space page; tap is a click on chip N (another space
                                       switches, the current one opens its page) or the title icon
    ./bench windows [new|open N URL|key N|close N|saved|quit]   ⌘N windows
    ./bench spaces [delete N|answer close|move|cancel]
                                       the Delete Space sheet, and its buttons
    ./bench spaces theme N [colors #hex[,#hex..]|intensity X|grain X|image PATH|none|blur X
                           |tone X|motion STYLE|none|speed X|clear]
                                       a space's own theme, as the Space page sets it
    ./bench spaces picture N PATH [light|dark]
    ./bench backdrop                   the column's animated scenes: WebContent pid, hidden, and
                                       the page's status() (clock time, wall, key, frames, fading)
    ./bench spaces swipe direction [system|natural|inverted]
                                       which way a swipe moves the column (Settings › Tabs)
    ./bench spaces slide [at X|off]    the last space switch's slide timings (ms from the click,
                                       frames, missed frames); `at X` holds the next slide at X
                                       the Space page as a PNG, drawn off screen, laid out whole
                                       spaces by index or name; --keep moves a deleted space's tabs
                                       to its neighbour; colours are Graphite Copper Orange Yellow
                                       Green Teal Blue Indigo Pink Red
    ./bench groups [new NAME|assign ID NAME|remove ID|suggest ID|dissolve NAME]
    ./bench groups [toggle NAME|inside PARENT NAME|plan [today]]
                                       folders: fold or open one (by its whole "A › B" name or
                                       its last part), or make one inside another
    ./bench sections [save ID|unsave ID|archive [HOURS]|window 12h|24h|48h|never]
                                       the sidebar's Saved and Today blocks: counts per space,
                                       move a tab across the seam, run the archive sweep now
                                       (with HOURS, against that age instead of the setting)
    ./bench flow sources               browsers Flow can see
    ./bench flow scan --source Chrome  cheap counts (no keychain prompt)
    ./bench flow root --source Chrome --path /tmp/copy
                                       use a test-only read-only source copy
    ./bench flow move --source Arc [--only tabs,bookmarks,history,cookies,localstorage,extensions] [--real]
                                       move in a test world; passwords/cookies ask macOS;
                                       waits and prints the report (also `flow status`)
    ./bench flow localstorage --source Arc --path OUT.json [--root DIR]
                                       Copper's own localStorage reader, as `arc-localstorage` JSON
    ./bench flow open [--again]        open the Move in sheet (--again: past "Moved from Arc on …")
    ./bench history import arc|chrome [--root PATH] [--limit N]
                                       import all URL history from an isolated copy
    ./bench storage import PATH [--only ORIGIN] [--profile-store NAME]
                                       put localStorage from `arc-localstorage` JSON into the
                                       shared website store (and NAME's profile jar), one hidden
                                       page per origin, nothing fetched; waits and prints the report
    ./bench storage status             the last import's report so far
    ./bench agent [on|off|rotate|setup-phi|setup-claude|setup-cli|setup-status]
                                       the MCP server agents drive the window through; setup bridges terminal agents
    ./bench ai [mode off|ask|auto]   which model lanes have keys, and the grouper's last note
    ./bench passkeys list|count|forget --id ID|answer yes|no|ask
                                       Copper's own test-world passkeys (no private keys in list)
    ./bench split [ID|off]           split the stage with tab ID (toggle with none)
    ./bench mouse back|forward|middle [X Y] [--shift]
                                       a click of that mouse button at window point X Y (top-left
                                       origin; the page's middle by default), through the app's routing
    ./bench bar TEXT [--go]          what ⌘K offers for TEXT; --go takes the first row
    ./bench newtab [TEXT] [--go [--pick N] [--how open|background|split]] [--keep] [--settle S] [--json]
                                       what ⌘T's card offers for TEXT, by group, after S seconds (0.8) for
                                       Google's completions and history; --go takes the picked row (or row N);
                                       --keep leaves the card up for `window`
    ./bench ui KEY VALUE               settings/passwords/welcome/history/downloads/bookmarks/hidden on|off,
                                       look light|dark|system, sidebar on|off, folded on|off, peek on|off,
                                       tabswitch row|recent, page general|tabs (which Settings page), focus none (the keyboard to the window itself), width N (the sidebar),
                                       addressHover on|off (the sidebar's address pill as under the pointer)

Needs Settings › General › "Let a script drive Copper" switched on in the
running app. IDs are the first characters of a tab's id, as `tabs` prints
them. With --test, talks to a SEARCH_PROBE run instead of the real one;
with --world NAME, to a SEARCH_PROBE=NAME run, the world "Copper (NAME)".
"""

import json
import os
import socket
import sys

def folder(world):
    name = f"Copper ({world})" if world else "Copper"
    return os.path.expanduser(f"~/Library/Application Support/{name}")

def ask(path, request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        try:
            s.connect(path)
        except (FileNotFoundError, ConnectionRefusedError):
            sys.exit("Copper isn't listening — is it open, with Settings › General › "
                     "“Let a script drive Copper” on?")
        s.sendall((json.dumps(request) + "\n").encode())
        chunks = []
        while True:
            chunk = s.recv(1 << 16)
            if not chunk:
                break
            chunks.append(chunk)
    line = b"".join(chunks).split(b"\n", 1)[0]
    return json.loads(line or b"{}")

def main(argv):
    world = "test" if "--test" in argv else None
    if "--world" in argv:
        at = argv.index("--world")
        if at + 1 >= len(argv): sys.exit("usage: bench --world NAME COMMAND …")
        world = "".join(c for c in argv[at + 1].lower() if c.isascii() and (c.isalnum() or c == "-"))
        if world in ("", "1"): world = "test"
        argv = argv[:at] + argv[at + 2:]
    yes = "--yes" in argv
    argv = [a for a in argv if a not in ("--test", "--yes")]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    verb, args = argv[0], argv[1:]
    request = {"do": verb}
    if verb == "open":
        if len(args) != 1: sys.exit("usage: bench open URL")
        request["url"] = args[0]
    elif verb == "go":
        if len(args) != 2: sys.exit("usage: bench go ID URL")
        request["id"], request["url"] = args
    elif verb in ("wait",):
        if not args: sys.exit("usage: bench wait ID [SECONDS]")
        request["id"] = args[0]
        if len(args) > 1: request["seconds"] = float(args[1])
    elif verb in ("text", "close", "sleep", "select"):
        if len(args) != 1: sys.exit(f"usage: bench {verb} ID")
        request["id"] = args[0]
    elif verb == "eval":
        if len(args) != 2: sys.exit("usage: bench eval ID JS")
        request["id"], request["js"] = args
    elif verb in ("click", "submit"):
        if len(args) != 2: sys.exit(f"usage: bench {verb} ID SELECTOR")
        request["id"], request["selector"] = args
    elif verb == "type":
        if len(args) != 3: sys.exit("usage: bench type ID SELECTOR TEXT")
        request["id"], request["selector"], request["text"] = args
    elif verb == "shot":
        if not args: sys.exit("usage: bench shot ID [PATH] [WIDTH]")
        request["id"] = args[0]
        if len(args) > 1: request["path"] = os.path.abspath(args[1])
        if len(args) > 2: request["width"] = float(args[2])
    elif verb == "backdrop":
        pass
    elif verb in ("split", "swipe"):
        request["arg"] = args[0] if args else ""
    elif verb == "mouse":
        request["arg"] = " ".join(args) if args else "back"
    elif verb == "bar":
        request["text"] = args[0] if args else ""
        request["go"] = "--go" in args
    elif verb == "summon":
        request["text"] = args[0] if args else ""
    elif verb == "newtab":
        flags = {"--go", "--keep", "--json"}
        rest, i = [], 0
        while i < len(args):
            if args[i] == "--pick" and i + 1 < len(args):
                request["pick"] = int(args[i + 1]); i += 2
            elif args[i] == "--how" and i + 1 < len(args):
                request["how"] = args[i + 1]; i += 2
            elif args[i] == "--settle" and i + 1 < len(args):
                request["settle"] = float(args[i + 1]); i += 2
            elif args[i] in flags:
                request[args[i][2:]] = True; i += 1
            else:
                rest.append(args[i]); i += 1
        request["text"] = rest[0] if rest else ""
    elif verb == "window":
        if not args: sys.exit("usage: bench window PATH [N]")
        request["path"] = os.path.abspath(args[0])
        if len(args) > 1: request["index"] = int(args[1])  # the Nth browser window (bench windows)
    elif verb == "passkeys":
        if not args: sys.exit("usage: bench passkeys list|count|forget --id ID|answer yes|no|ask")
        request["op"] = args[0]
        if args[0] == "forget":
            if len(args) == 3 and args[1] == "--id": request["arg"] = args[2]
            elif len(args) == 2: request["arg"] = args[1]
            else: sys.exit("usage: bench passkeys forget --id ID")
        elif args[0] == "answer":
            if len(args) != 2 or args[1] not in ("yes", "no", "ask"): sys.exit("usage: bench passkeys answer yes|no|ask")
            request["arg"] = args[1]
        elif len(args) > 1:
            sys.exit("usage: bench passkeys list|count|forget --id ID|answer yes|no|ask")
    elif verb == "render":
        if len(args) < 2: sys.exit("usage: bench render bitwarden|drive|hands|hands-dark PATH")
        request["op"] = args[0]
        request["path"] = os.path.abspath(args[1])
    elif verb in ("spaces", "groups", "sections", "agent", "ai", "updates", "bw", "downloads", "drive", "ext-manager", "windows"):
        request["op"] = args[0] if args else ("status" if verb in ("updates", "bw", "drive") else "list")
        request["arg"] = " ".join(args[1:]) if len(args) > 1 else ""
    elif verb == "history":
        if not args or args[0] != "import" or len(args) < 2:
            sys.exit("usage: bench history import arc|chrome [--root PATH] [--limit N]")
        request["op"] = "import"
        request["source"] = args[1]
        i = 2
        while i < len(args):
            if args[i] == "--root" and i + 1 < len(args):
                request["root"] = args[i + 1]; i += 2
            elif args[i] == "--limit" and i + 1 < len(args):
                request["limit"] = int(args[i + 1]); i += 2
            else:
                sys.exit("usage: bench history import arc|chrome [--root PATH] [--limit N]")
    elif verb == "storage":
        usage = "usage: bench storage import PATH [--only ORIGIN] [--profile-store NAME] | storage status"
        if not args or args[0] not in ("import", "status"): sys.exit(usage)
        request["op"] = args[0]
        if args[0] == "import":
            if len(args) < 2: sys.exit(usage)
            request["path"] = os.path.abspath(args[1])
            rest = args[2:]
            while rest:
                if rest[0] == "--only" and len(rest) > 1: request["only"] = rest[1]
                elif rest[0] == "--profile-store" and len(rest) > 1: request["profileStore"] = rest[1]
                else: sys.exit(usage)
                rest = rest[2:]
    elif verb == "flow":
        if not args: sys.exit("usage: bench flow sources|scan|move|status|localstorage|open")
        request["op"] = args[0]
        rest = args[1:]
        i = 0
        while i < len(rest):
            if rest[i] == "--source" and i + 1 < len(rest):
                request["source"] = rest[i + 1]; i += 2
            elif rest[i] == "--path" and i + 1 < len(rest):
                request["path"] = rest[i + 1]; i += 2
            elif rest[i] == "--only" and i + 1 < len(rest):
                request["only"] = rest[i + 1]; i += 2
            elif rest[i] == "--root" and i + 1 < len(rest):
                request["root"] = os.path.abspath(rest[i + 1]); i += 2
            elif rest[i] == "--real":
                request["real"] = True; i += 1
            elif rest[i] == "--again":
                request["again"] = True; i += 1
            else:
                i += 1
    elif verb == "ui":
        if len(args) != 2: sys.exit("usage: bench ui KEY VALUE")
        key, value = args
        if key == "width": request[key] = float(value)
        elif key in ("look", "focus", "tabswitch", "page"): request[key] = value
        else: request[key] = value in ("on", "true", "1", "yes")
    elif verb in ("ext-add", "ext-press", "ext-remove", "ext-reload"):
        if len(args) != 1: sys.exit(f"usage: bench {verb} ID")
        request["id"] = args[0]
        request["yes"] = yes
    elif verb == "ext-enable":
        if len(args) != 2: sys.exit("usage: bench ext-enable ID on|off")
        request["id"] = args[0]
        request["on"] = args[1] in ("on", "true", "1", "yes")
    elif verb == "ext-pin":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench ext-pin ID [on|off]")
        request["id"] = args[0]
        request["on"] = (args[1] if len(args) > 1 else "on") in ("on", "true", "1", "yes")
    elif verb == "ext-answer":
        if len(args) != 1 or args[0] not in ("yes", "no", "ask"): sys.exit("usage: bench ext-answer yes|no|ask")
        request["answer"] = args[0]
    elif verb == "ext-shot":
        if len(args) != 2: sys.exit("usage: bench ext-shot ID PATH")
        request["id"] = args[0]
        request["path"] = os.path.abspath(args[1])
    elif verb == "ext-menu":
        if len(args) != 1: sys.exit("usage: bench ext-menu PATH")
        request["path"] = os.path.abspath(args[0])
    elif verb == "ext-folder":
        if len(args) != 1: sys.exit("usage: bench ext-folder PATH")
        request["path"] = os.path.abspath(args[0])
        request["yes"] = yes
    elif verb == "ext-popup":
        if len(args) != 2: sys.exit("usage: bench ext-popup ID JS")
        request["id"], request["js"] = args
    elif verb == "ext-page":
        if not args: sys.exit("usage: bench ext-page ID [PATH]")
        request["id"] = args[0]
        request["path"] = args[1] if len(args) > 1 else ""
    elif verb == "key":
        via_app = "--app" in args
        hold = "--hold" in args
        args = [a for a in args if a not in ("--app", "--hold")]
        if len(args) != 2: sys.exit("usage: bench key ID TEXT [--app] [--hold]")
        request["id"], request["text"] = args
        if via_app: request["via"] = "app"
        if hold: request["hold"] = True
    elif verb == "resize":
        if len(args) not in (2, 3): sys.exit("usage: bench resize WIDTH HEIGHT [STEPS]")
        request["width"], request["height"] = float(args[0]), float(args[1])
        if len(args) == 3: request["steps"] = int(args[2])
    elif verb not in ("tabs", "probe", "extensions"):
        sys.exit(f"unknown command “{verb}” — see bench help")

    answer = ask(os.path.join(folder(world), "bench.sock"), request)
    if answer.get("error"):
        sys.exit("error: " + str(answer["error"]))
    if verb == "flow" and request.get("op") == "move" and answer.get("started"):
        # Same for a move: it runs on in Copper (keychain prompt, minutes of
        # local storage), so poll its status and print the finished report.
        import time
        while True:
            time.sleep(1)
            answer = ask(os.path.join(folder(world), "bench.sock"), {"do": "flow", "op": "status"})
            if not answer.get("running"): break
            print("\r" + " · ".join(answer.get("lines", []))[-120:], end="", file=sys.stderr, flush=True)
        print(file=sys.stderr)
    if verb == "storage" and answer.get("started"):
        # The import runs on in Copper; the bench answers within 25 s, so ask
        # for the report until it is done rather than holding one request.
        import time
        while True:
            time.sleep(1)
            answer = ask(os.path.join(folder(world), "bench.sock"), {"do": "storage", "op": "status"})
            print(f"\r{answer.get('done')}/{answer.get('total')} origins", end="", file=sys.stderr, flush=True)
            if not answer.get("running"): break
        print(file=sys.stderr)
    if verb == "text":
        print(answer.get("text", ""))
        if answer.get("truncated"):
            print("\n[… truncated]", file=sys.stderr)
    elif verb == "shot":
        print(answer["path"])
    elif verb in ("open", "ext-page"):
        print(answer["id"])
    elif verb in ("eval", "ext-popup"):
        value = answer.get("value")
        print(value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, indent=2))
    elif verb in ("updates", "bw", "drive", "render"):
        print(json.dumps(answer, ensure_ascii=False, sort_keys=True))
    elif verb == "newtab":
        if request.get("json"):
            print(json.dumps(answer, ensure_ascii=False, indent=2))
            return 0
        picked = answer.get("picked", -1)
        for g in answer.get("groups", []):
            if g.get("heading"): print(f"— {g['heading']}")
            for r in g.get("rows", []):
                mark = "›" if r["index"] == picked else " "
                extra = "  ".join(x for x in (r.get("detail"), r.get("badge")) if x)
                aside = f"  [{r['aside']}]" if r.get("aside") and r["index"] == picked else ""
                print(f"{mark} {r['index']:2} {r['kind']:8} {r['key']}  {extra}  → {r['hint']}{aside}")
        print(f"latency: {answer.get('milliseconds', 0):.2f} ms  suggest asks: {answer.get('suggestAsks')}  cancelled: {answer.get('suggestCancelled')}")
        print(f"tabs: {answer.get('tabsBefore')} → {answer.get('tabsAfter')}  active: {answer.get('active', {}).get('title', '')}  space: {answer.get('space', '')}")
    elif verb == "bar":
        for o in answer.get("offers", []):
            badge = f"  {o['badge']}" if o.get("badge") else ""
            print(f"{o['kind']:9} {o['key']}  {o['title']}{badge}")
        if answer.get("completion"):
            print(f"completion: {answer['completion']}")
        if answer.get("milliseconds") is not None:
            print(f"latency: {answer['milliseconds']:.2f} ms")
    elif verb == "spaces":
        if "slide" in answer: print(json.dumps(answer["slide"], ensure_ascii=False))
        if "sheet" in answer: print(json.dumps(answer["sheet"], ensure_ascii=False))
        if "path" in answer: print(answer["path"])
        if "page" in answer: print(f"page: {answer['page'] or 'closed'}" + (f"  (current: {answer['current']})" if answer.get("current") else ""))
        for s in answer.get("spaces", []):
            icon = f" {s['icon']}" if s.get("icon") else ""
            print(f"{'●' if s['current'] else ' '} {s['index']}  {s['name']}{icon}  ({s['tabs']} tabs, {s['profile']}, {s.get('colour', '')})")
            if s.get("theme") and s["theme"] != "hue": print(f"      theme {s['theme']}")
    elif verb == "sections":
        if "archived" in answer:
            print(f"archived {answer['archived']} tab(s)")
            if not answer["archived"]:
                print(f"  nothing in Today is older than the window — oldest row is {answer.get('oldest')}h;"
                      f" `sections archive HOURS` sweeps against that age instead")
        print(f"archive window: {answer.get('window')}, oldest row in Today: {answer.get('oldest')}h")
        for s in answer.get("spaces", []):
            print(f"{'●' if s['current'] else ' '} {s['name']:22} {s['favourites']:3} favourites  {s['saved']:4} saved  {s['today']:4} today")
        for t in answer.get("today", []):
            print(f"    {t['id']}  {t['seen']}h  {t['title'] or '—'}")
    elif verb == "tabs":
        for tab in answer.get("tabs", []):
            mark = "⚗" if tab.get("bench") else ("●" if tab.get("active") else " ")
            state = " …" if tab.get("loading") else (" z" if tab.get("asleep") else "")
            print(f"{mark} {tab['id']}  {tab.get('title') or '—'}  {tab.get('url')}{state}")
    else:
        print(json.dumps(answer, ensure_ascii=False, indent=2))
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
